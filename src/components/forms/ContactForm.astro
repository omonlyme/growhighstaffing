---
import FormShell from './FormShell.astro';
import Field from './Field.astro';
import { site } from '../../config/site';
---

<FormShell formName="Contact" subject={`New contact message — ${site.name} website`} submitLabel="Send Message">
  <div class="form-row">
    <Field name="Name" label="Full name" required autocomplete="name" placeholder="Your name" />
    <Field name="email" label="Email address" type="email" required autocomplete="email" placeholder="you@example.com" />
  </div>
  <div class="form-row">
    <Field name="Phone" label="Phone number" type="tel" autocomplete="tel" inputmode="tel" placeholder="+91 98765 43210" />
    <Field name="Enquiry type" label="I am a…" required options={['Employer looking to hire', 'Job seeker / Candidate', 'Other']} placeholder="Select one" />
  </div>
  <Field name="Subject" label="Subject" placeholder="How can we help?" />
  <Field name="Message" label="Message" textarea required placeholder="Tell us a little about your enquiry…" />
</FormShell>
