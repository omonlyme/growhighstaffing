---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumbs?: { label: string; href?: string }[];
}
const { eyebrow, title, intro, image, imageAlt = '', crumbs = [] } = Astro.props;
---

<section class="page-hero on-dark">
  {image && <Image src={image} alt={imageAlt} class="page-hero-bg" widths={[800, 1400, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />}
  <div class="page-hero-overlay"></div>
  <div class="diamond" style="--d:380px; right:-90px; top:20px"></div>
  <div class="diamond" style="--d:180px; right:220px; bottom:-90px; border-color: rgb(243 146 0 / 0.25)"></div>

  <div class="container page-hero-inner">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <span class="eyebrow">{eyebrow}</span>
    <h1 set:html={title} />
    <p class="lead">{intro}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--navy-900);
    padding: calc(var(--header-h) + clamp(3.5rem, 8vw, 6rem)) 0 clamp(4rem, 8vw, 6.5rem);
    color: var(--white);
  }
  .page-hero :global(.page-hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .page-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(700px 400px at 90% 0%, rgb(27 108 168 / 0.45), transparent 70%),
      linear-gradient(100deg, rgb(6 26 46 / 0.97) 0%, rgb(10 37 64 / 0.9) 45%, rgb(14 53 87 / 0.6) 100%);
  }
  .page-hero-inner {
    position: relative;
    animation: hero-in 0.9s var(--ease) both;
  }
  .page-hero-inner > :global(*) {
    max-width: 820px;
  }
  h1 {
    color: var(--white);
    margin: 1rem 0 1.25rem;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
  }
  .lead {
    color: rgb(255 255 255 / 0.78);
    max-width: 640px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-bottom: 1.75rem;
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.55);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }
  .crumbs a {
    color: rgb(255 255 255 / 0.7);
  }
  .crumbs a:hover {
    color: var(--orange-500);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
