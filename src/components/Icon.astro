const isBrand = name.startsWith('brand:');
const key = isBrand ? name.slice(6) : name;
const body = isBrand ? filled[key] : stroke[key];
if (!body) throw new Error(`Icon "${name}" not found`);
---

{
  isBrand ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="currentColor"
      class:list={['icon', className]}
      aria-hidden={label ? undefined : 'true'}
      aria-label={label}
      role={label ? 'img' : undefined}
      set:html={body}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={['icon', className]}
      aria-hidden={label ? undefined : 'true'}
      aria-label={label}
      role={label ? 'img' : undefined}
      set:html={body}
    />
  )
}
