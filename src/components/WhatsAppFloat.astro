---
import Icon from './Icon.astro';
import { whatsappLink } from '../config/site';
const href = whatsappLink();
---

{
  href && (
    <a class="wa-float" href={href} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
      <Icon name="brand:whatsapp" size={28} />
      <span class="wa-label">Chat with us</span>
    </a>
  )
}

<style>
  .wa-float {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 0;
    height: 60px;
    min-width: 60px;
    padding: 0 16px;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    box-shadow: 0 12px 28px -8px rgb(37 211 102 / 0.6), 0 4px 10px rgb(0 0 0 / 0.12);
    transition:
      transform 0.3s var(--ease),
      gap 0.3s var(--ease);
    animation: wa-in 0.6s 1.2s var(--ease) both;
  }
  .wa-float::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #25d366;
    animation: wa-pulse 2.6s 2s infinite;
  }
  .wa-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: var(--fs-sm);
    transition: max-width 0.35s var(--ease);
  }
  .wa-float:hover {
    color: #fff;
    transform: translateY(-3px);
    gap: 0.6rem;
  }
  .wa-float:hover .wa-label {
    max-width: 140px;
  }
  @keyframes wa-in {
    from {
      opacity: 0;
      transform: scale(0.6) translateY(20px);
    }
  }
  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }
</style>
