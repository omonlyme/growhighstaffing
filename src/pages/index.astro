---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import JobCard from '../components/JobCard.astro';
import CTABanner from '../components/CTABanner.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import { services } from '../data/services';
import { industries } from '../data/industries';
import { whyChoose } from '../data/process';
import { jobs } from '../data/jobs';
import { site } from '../config/site';
import heroImg from '../assets/images/hero-buildings.jpg';
import aboutImg from '../assets/images/about-meeting.jpg';

const latestJobs = [...jobs].sort((a, b) => b.posted.localeCompare(a.posted)).slice(0, 3);
---

<BaseLayout>
  <!-- ───────── Hero ───────── -->
  <section class="hero on-dark">
    <div class="hero-bg" aria-hidden="true">
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
      <div class="grid-lines"></div>
      <div class="diamond" style="--d:520px; right:-160px; top:-120px"></div>
      <div class="diamond" style="--d:240px; left:-90px; bottom:-60px; border-color: rgb(243 146 0 / 0.18)"></div>
    </div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow hero-anim" style="--d:0ms">Recruitment &amp; Staffing Solutions</span>
        <h1 class="hero-anim" style="--d:80ms">Connecting Talent with <span class="text-gradient">Opportunity.</span></h1>
        <p class="lead hero-anim" style="--d:160ms">
          {site.name} helps businesses find skilled, qualified and experienced professionals — and helps candidates
          discover rewarding careers. Reliable recruitment, quality talent and efficient workforce solutions.
        </p>
        <div class="btn-row hero-anim" style="--d:240ms">
          <a href="/employers/#enquiry" class="btn btn--primary">Hire Talent <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
          <a href="/candidates/" class="btn btn--ghost-light">Find a Job</a>
        </div>
        <ul class="hero-points hero-anim" style="--d:320ms">
          <li><Icon name="circle-check" size={18} /> Permanent &amp; contract staffing</li>
          <li><Icon name="circle-check" size={18} /> Bulk &amp; executive hiring</li>
          <li><Icon name="circle-check" size={18} /> Multi-industry expertise</li>
        </ul>
      </div>

      <div class="hero-visual hero-anim" style="--d:200ms">
        <div class="hero-photo">
          <Image src={heroImg} alt="Modern glass office buildings against a blue sky" widths={[480, 720, 960]} sizes="(min-width: 960px) 520px, 90vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="float-card float-card--a">
          <span class="float-icon"><Icon name="user-check" size={20} /></span>
          <div><strong>Pre-screened profiles</strong><span>Shortlists matched to your role</span></div>
        </div>
        <div class="float-card float-card--b">
          <span class="float-icon float-icon--orange"><Icon name="layers" size={20} /></span>
          <div><strong>{services.length} hiring solutions</strong><span>Across {industries.length} industries</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── Audience split ───────── -->
  <section class="audience">
    <div class="container audience-grid">
      <a href="/employers/" class="audience-card reveal">
        <span class="icon-badge"><Icon name="building" size={26} /></span>
        <div>
          <span class="audience-kicker">For Employers</span>
          <h2>Hire the right people, faster</h2>
          <p>Share your requirements and receive a focused shortlist of qualified candidates.</p>
        </div>
        <Icon name="arrow-right" size={22} class="audience-arrow" />
      </a>
      <a href="/candidates/" class="audience-card reveal" style="--delay:100ms">
        <span class="icon-badge icon-badge--orange"><Icon name="briefcase" size={26} /></span>
        <div>
          <span class="audience-kicker">For Candidates</span>
          <h2>Take the next step in your career</h2>
          <p>Explore current openings or submit your resume for future opportunities.</p>
        </div>
        <Icon name="arrow-right" size={22} class="audience-arrow" />
      </a>
    </div>
  </section>

  <!-- ───────── Clients ───────── -->
  <ClientMarquee />

  <!-- ───────── Intro ───────── -->
  <section class="section">
    <div class="container split">
      <div class="media-frame reveal">
        <div class="media intro-media">
          <Image src={aboutImg} alt="A team meeting in a modern conference room" widths={[480, 800, 1100]} sizes="(min-width: 960px) 560px, 90vw" />
        </div>
      </div>
      <div class="reveal" style="--delay:120ms">
        <span class="eyebrow">Who We Are</span>
        <h2 class="mt">A recruitment partner focused on the right fit</h2>
        <p class="lead mt-sm">
          {site.name} is a professional recruitment and staffing solutions company focused on connecting the right talent
          with the right opportunities.
        </p>
        <p class="mt-sm">
          Our goal is to simplify hiring through reliable recruitment services, quality talent acquisition and efficient
          workforce solutions — so businesses can grow with confidence and professionals can build meaningful careers.
        </p>
        <ul class="check-list mt">
          <li><Icon name="check" size={18} /> Requirement-led sourcing and careful screening</li>
          <li><Icon name="check" size={18} /> Flexible permanent, contract and bulk hiring models</li>
          <li><Icon name="check" size={18} /> Clear communication from brief to joining</li>
        </ul>
        <a href="/about/" class="btn btn--navy mt">More About Us <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ───────── Services ───────── -->
  <section class="section section--tint">
    <div class="container">
      <SectionHeading
        eyebrow="Our Services"
        title="Recruitment solutions for every hiring need"
        intro="From a single specialist hire to large-scale recruitment drives, we offer flexible services built around your business."
      />
      <div class="grid grid-4">
        {services.map((s, i) => <ServiceCard service={s} delay={(i % 4) * 80} />)}
        <a href="/contact/" class="card help-card reveal" style="--delay:240ms">
          <h3>Not sure what you need?</h3>
          <p>Talk to our team and we’ll recommend the right hiring approach for your situation.</p>
          <span class="link-arrow">Talk to us <Icon name="arrow-right" size={16} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────── Why choose us ───────── -->
  <section class="section section--dark why">
    <div class="diamond" style="--d:460px; left:-200px; top:10%"></div>
    <div class="container why-grid">
      <div class="why-intro reveal">
        <span class="eyebrow">Why Choose Us</span>
        <h2 class="mt">Why choose {site.name}?</h2>
        <p class="lead mt-sm">
          We combine a structured recruitment process with genuine attention to people — so every placement works for both
          the employer and the candidate.
        </p>
        <a href="/employers/#enquiry" class="btn btn--primary mt">Start Hiring <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
      </div>
      <div class="why-list">
        {
          whyChoose.map((w, i) => (
            <div class="why-item m-row reveal" style={`--delay:${(i % 2) * 100}ms`}>
              <span class="why-icon m-icon"><Icon name={w.icon} size={22} /></span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────── Industries ───────── -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Industries We Serve"
        title="Sector knowledge that makes a difference"
        intro="We recruit across a wide range of industries, understanding the roles, skills and expectations specific to each."
      />
      <div class="grid grid-4">
        {industries.map((ind, i) => <IndustryCard industry={ind} delay={(i % 4) * 80} />)}
      </div>
      <div class="center mt-lg reveal">
        <a href="/industries/" class="btn btn--outline">Explore Industries <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ───────── Process ───────── -->
  <section class="section section--blue">
    <div class="container">
      <SectionHeading
        eyebrow="Our Recruitment Process"
        title="A clear, structured path from brief to joining"
        intro="A proven five-step approach that keeps hiring focused, transparent and efficient."
      />
      <ProcessSteps />
    </div>
  </section>

  <!-- ───────── Latest jobs ───────── -->
  {
    latestJobs.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="jobs-head">
            <SectionHeading eyebrow="Current Openings" title="Latest opportunities" align="left" intro="Browse a selection of roles we are currently hiring for." />
            <a href="/candidates/#jobs" class="btn btn--outline reveal">View All Jobs <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
          </div>
          <div class="grid grid-3">
            {latestJobs.map((job) => (
              <div class="reveal job-wrap">
                <JobCard job={job} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTABanner />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(160deg, var(--navy-950) 0%, var(--navy-900) 45%, var(--navy-800) 100%);
    color: var(--white);
    padding: calc(var(--header-h) + clamp(3rem, 7vw, 5.5rem)) 0 clamp(7rem, 12vw, 9rem);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }
  .glow-1 {
    width: 620px;
    height: 620px;
    right: -120px;
    top: -180px;
    background: rgb(27 108 168 / 0.55);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .glow-2 {
    width: 420px;
    height: 420px;
    left: -140px;
    bottom: -200px;
    background: rgb(243 146 0 / 0.18);
    animation: drift 22s ease-in-out infinite alternate-reverse;
  }
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 20%, transparent 75%);
  }
  @keyframes drift {
    to {
      transform: translate(-60px, 40px) scale(1.08);
    }
  }
  .hero-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 4rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .hero h1 {
    color: var(--white);
    margin: 1.25rem 0 1.5rem;
  }
  .hero .lead {
    color: rgb(255 255 255 / 0.76);
    max-width: 580px;
    margin-bottom: 2.25rem;
  }
  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    padding: 0;
    margin-top: 2.25rem;
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.8);
  }
  .hero-points li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .hero-points :global(.icon) {
    color: var(--orange-500);
  }
  .hero-anim {
    animation: rise 1s var(--ease) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  .hero-visual {
    position: relative;
    max-width: 520px;
    width: 100%;
    justify-self: center;
  }
  .hero-photo {
    position: relative;
    border-radius: 36% 36% var(--radius-xl) var(--radius-xl) / 28% 28% var(--radius-xl) var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 4.6;
    box-shadow: 0 40px 80px -24px rgb(0 0 0 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% center;
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(6 26 46 / 0.5));
  }
  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.15rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.96);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
    animation: float 6s ease-in-out infinite;
  }
  .float-card strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .float-card span:not(.float-icon) {
    font-size: var(--fs-xs);
    color: var(--slate-500);
  }
  .float-card--a {
    left: -8%;
    top: 16%;
  }
  .float-card--b {
    right: -6%;
    bottom: 10%;
    animation-delay: -3s;
  }
  .float-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--blue-50);
    color: var(--blue-600);
    flex-shrink: 0;
  }
  .float-icon--orange {
    background: var(--orange-100);
    color: var(--orange-600);
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 639px) {
    .hero-visual {
      max-width: 340px;
    }
    .hero-photo {
      aspect-ratio: 1 / 1;
    }
    .float-card {
      padding: 0.7rem 0.9rem;
    }
  }
  @media (max-width: 600px) {
    .float-card--a {
      left: -2%;
      top: 6%;
    }
    .float-card--b {
      right: -2%;
    }
  }

  /* Audience split */
  .audience {
    position: relative;
    z-index: 2;
    margin-top: clamp(-4.5rem, -7vw, -3.5rem);
  }
  .audience-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 860px) {
    .audience-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .audience-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--slate-200);
    box-shadow: var(--shadow-lg);
    color: inherit;
    transition: transform 0.35s var(--ease);
  }
  .audience-card:hover {
    transform: translateY(-4px);
    color: inherit;
  }
  .audience-card .icon-badge {
    margin: 0;
  }
  .audience-card > div {
    flex: 1;
  }
  .audience-kicker {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--orange-600);
  }
  .audience-card h2 {
    font-size: 1.25rem;
    margin: 0.25rem 0 0.35rem;
  }
  .audience-card p {
    font-size: var(--fs-sm);
    color: var(--slate-600);
  }
  .audience-card :global(.audience-arrow) {
    flex-shrink: 0;
    color: var(--blue-600);
    transition: transform 0.3s var(--ease);
  }
  .audience-card:hover :global(.audience-arrow) {
    transform: translateX(5px);
  }
  @media (max-width: 520px) {
    .audience-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .audience-card :global(.audience-arrow) {
      display: none;
    }
  }

  .intro-media {
    aspect-ratio: 5 / 4;
  }

  .help-card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background:
      radial-gradient(300px 200px at 100% 0%, rgb(243 146 0 / 0.35), transparent 70%),
      linear-gradient(140deg, var(--navy-900), var(--navy-700));
    border: 0;
    color: rgb(255 255 255 / 0.78);
    min-height: 260px;
  }
  .help-card h3 {
    color: var(--white);
  }
  .help-card p {
    color: rgb(255 255 255 / 0.75);
    margin-bottom: 1.25rem;
  }
  .help-card .link-arrow {
    color: var(--orange-500);
  }
  .help-card:hover {
    color: rgb(255 255 255 / 0.78);
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  /* Why */
  .why {
    overflow: hidden;
    background:
      radial-gradient(800px 500px at 100% 100%, rgb(27 108 168 / 0.35), transparent 70%),
      var(--navy-900);
  }
  .why-grid {
    position: relative;
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
      align-items: start;
    }
    .why-intro {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
  .why-list {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .why-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .why-item {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.09);
    transition:
      background 0.3s,
      border-color 0.3s,
      transform 0.35s var(--ease);
  }
  .why-item:hover {
    background: rgb(255 255 255 / 0.07);
    border-color: rgb(243 146 0 / 0.4);
    transform: translateY(-4px);
  }
  .why-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgb(243 146 0 / 0.14);
    color: var(--orange-500);
    margin-bottom: 1.1rem;
  }
  .why-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.45rem;
  }
  .why-item p {
    font-size: var(--fs-sm);
    color: rgb(255 255 255 / 0.68);
  }

  .job-wrap {
    display: grid;
  }
  .jobs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }
  .jobs-head :global(.section-heading) {
    margin-bottom: 0;
  }
</style>
