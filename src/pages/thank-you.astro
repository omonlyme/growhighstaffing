---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../config/site';
const wa = whatsappLink();
---

<BaseLayout title="Thank You" noindex description={`Thank you for contacting ${site.name}.`}>
  <section class="status-page">
    <div class="container status-inner">
      <div class="status-icon"><Icon name="circle-check" size={44} /></div>
      <h1 data-ty-title>Thank you!</h1>
      <p class="lead" data-ty-text>Your message has been sent successfully. Our team will get back to you shortly.</p>
      <div class="btn-row">
        <a href="/" class="btn btn--navy">Back to Home</a>
        <a href="/candidates/#jobs" class="btn btn--outline">View Openings</a>
        {wa && <a href={wa} class="btn btn--whatsapp" target="_blank" rel="noopener"><Icon name="brand:whatsapp" size={18} /> WhatsApp Us</a>}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = new URLSearchParams(location.search).get('form');
  const copy: Record<string, [string, string]> = {
    'Job Application': ['Application received!', 'Thank you for applying. Our recruitment team will review your profile and contact you if there’s a suitable match.'],
    'Employer Enquiry': ['Enquiry received!', 'Thank you for your hiring enquiry. A member of our team will contact you shortly to discuss your requirements.'],
    'Callback Request': ['Callback requested!', 'Thank you. We’ll call you back at your preferred time.'],
  };
  if (form && copy[form]) {
    document.querySelector('[data-ty-title]')!.textContent = copy[form][0];
    document.querySelector('[data-ty-text]')!.textContent = copy[form][1];
  }
</script>
